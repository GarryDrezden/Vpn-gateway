<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SelectiveVpnRouter.App</RootNamespace>
    <ApplicationIcon>vpn-route-icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SelectiveVpnRouter.Core\SelectiveVpnRouter.Core.csproj" />
    <Resource Include="vpn-route-icon.ico" />
    <Content Include="vpn-route-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="EmbedAppIcon" AfterTargets="Build;Publish;_CopyResolvedFilesToPublishPreserveNewest" Condition="'$(OutputType)' == 'WinExe' AND Exists('$(MSBuildProjectDirectory)\vpn-route-icon.ico')">
    <PropertyGroup>
      <_AppExeForIcon Condition="'$(_AppExeForIcon)' == '' and '$(PublishDir)' != ''">$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_AppExeForIcon>
      <_AppExeForIcon Condition="'$(_AppExeForIcon)' == ''">$([System.IO.Path]::Combine('$(TargetDir)', '$(AssemblyName).exe'))</_AppExeForIcon>
    </PropertyGroup>
    <Message Importance="high" Text="EmbedAppIcon: $(_AppExeForIcon)" />
    <Exec Condition="Exists('$(_AppExeForIcon)')" Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\embed-app-icon.ps1&quot; -Exe &quot;$(_AppExeForIcon)&quot; -Ico &quot;$(MSBuildProjectDirectory)\vpn-route-icon.ico&quot;" />
  </Target>
</Project>
