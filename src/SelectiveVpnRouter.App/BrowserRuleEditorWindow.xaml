<Window x:Class="SelectiveVpnRouter.App.BrowserRuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правило маршрутизации сайта"
        SizeToContent="WidthAndHeight"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBackgroundBrush}"
        ResizeMode="NoResize">
  <Border Style="{StaticResource CardBorder}" Margin="16">
    <StackPanel MinWidth="420">
      <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
      <TextBlock Text="Название" Style="{StaticResource SecondaryText}"/>
      <TextBox x:Name="NameBox" Margin="0,4,0,8"/>
      <TextBlock Text="Домен" Style="{StaticResource SecondaryText}"/>
      <TextBox x:Name="HostBox" Margin="0,4,0,8"/>
      <TextBlock Text="Тип совпадения" Style="{StaticResource SecondaryText}"/>
      <ComboBox x:Name="MatchTypeBox" Margin="0,4,0,8"/>
      <TextBlock Text="Маршрут" Style="{StaticResource SecondaryText}"/>
      <ComboBox x:Name="RouteBox" Margin="0,4,0,8"/>
      <CheckBox x:Name="EnabledBox" Content="Правило включено" Margin="0,0,0,8"/>
      <TextBlock Text="Заметки (необязательно)" Style="{StaticResource SecondaryText}"/>
      <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="72" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" IsCancel="True" Style="{StaticResource SecondaryButton}" MinWidth="90" Margin="0,0,8,0"/>
        <Button x:Name="SaveButton" Content="Сохранить" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="110" Click="OnSave"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
