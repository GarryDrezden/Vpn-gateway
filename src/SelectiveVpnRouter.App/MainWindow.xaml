<Window x:Class="SelectiveVpnRouter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPN Route"
        Icon="vpn-route-icon.ico"
        Width="1200" Height="780"
        MinWidth="1000" MinHeight="650"
        Background="{StaticResource PageBackgroundBrush}"
        Closing="OnClosing">
  <Grid>
    <DockPanel x:Name="RootDock">
    <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Background="{StaticResource ShellHeaderBrush}" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="3"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BrandPrimaryBrush}"/>
        <DockPanel Grid.Row="1" Margin="16,12,16,12" LastChildFill="True">
          <Image DockPanel.Dock="Left" Source="vpn-route-icon.ico" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="VPN Route" Style="{StaticResource AppTitleText}"/>
            <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource AppSubtitleText}" Text="Маршрутизация · контроль · приватность"/>
          </StackPanel>
        </DockPanel>
      </Grid>
    </Border>

    <Border x:Name="ServiceBanner" DockPanel.Dock="Top"
            Background="{StaticResource ServiceBannerBackgroundBrush}"
            BorderBrush="{StaticResource ServiceBannerBorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,8" Visibility="Collapsed">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Повторить" Click="OnRetryService" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
        <TextBlock x:Name="ServiceBannerText" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource ServiceBannerTextBrush}" Text="Служба VPN Route недоступна."/>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource ShellTabHostBorder}">
    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
      <!-- HOME -->
      <TabItem Header="Главная">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <Border x:Name="HomeWorkVpnCard" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Рабочий VPN" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse x:Name="HomeWorkVpnStatusDot" Width="12" Height="12" Fill="{StaticResource NeutralStatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeWorkVpnStatusText" Text="Отключён" Style="{StaticResource StatusHeadlineText}" Margin="10,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="HomeWorkVpnSubtitle" Text="Корпоративный split-tunnel (отдельный OpenVPN)"
                             Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="22,0,0,12"/>
                  <TextBlock Text="Профиль" Style="{StaticResource SecondaryText}"/>
                  <TextBlock x:Name="HomeWorkProfileText" Text="—" TextWrapping="Wrap" Margin="0,2,0,6"/>
                  <TextBlock Text="Адрес" Style="{StaticResource SecondaryText}"/>
                  <TextBlock x:Name="HomeWorkAddressText" Text="—" Margin="0,2,0,12"/>
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConnectWorkVpnButton" Content="Подключить" Click="OnStartWorkVpn" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="DisconnectWorkVpnButton" Content="Отключить" Click="OnStopWorkVpn" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="HomeAppVpnCard" Style="{StaticResource HeroCardBorder}">
                <StackPanel>
                  <TextBlock Text="VPN приложений" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse x:Name="HomeVpnStatusDot" Width="14" Height="14" Fill="{StaticResource NeutralStatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeVpnStatusText" Text="VPN Route выключен" Style="{StaticResource StatusHeadlineText}" Margin="10,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="HomeVpnSubtitle" Text="Selective WFP → proxy → OpenVPN"
                             Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="22,0,0,14"/>

                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Профиль" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="HomeProfileText" Grid.Row="0" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Интернет" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeDirectAdapterText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="VPN" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeVpnAdapterText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Адрес VPN" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeVpnAddressText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                  </Grid>

                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConnectVpnButton" Content="Подключить VPN Route" Click="OnStart" Style="{StaticResource PrimaryButton}" MinWidth="200"/>
                    <Button x:Name="DisconnectVpnButton" Content="Отключить" Click="OnStop" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="Браузерная маршрутизация" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="170"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Браузерное расширение" Style="{StaticResource SecondaryText}"/>
                    <TextBlock x:Name="HomeBrowserExtensionText" Grid.Row="0" Grid.Column="1" Text="—" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Browser API" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserApiText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Browser Proxy" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserProxyText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="SOCKS" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserSocksText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="VPN egress" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserVpnEgressText" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="VPN интерфейс" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserVpnInterfaceText" Grid.Row="5" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Правил" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserRuleCountText" Grid.Row="6" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Последний контакт" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserLastContactText" Grid.Row="7" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                    <TextBlock x:Name="HomeBrowserDetailText" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
              <StackPanel>
                <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Приложений через VPN" Style="{StaticResource SecondaryText}"/>
                  <TextBlock x:Name="HomeAppsCountText" Grid.Row="0" Grid.Column="1" Text="0" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Активных правил" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeRoutingActiveCountText" Grid.Row="1" Grid.Column="1" Text="0" Margin="0,6,0,0"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Напрямую" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeRoutingDirectCountText" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,6,0,0"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Драйвер" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse x:Name="HomeDriverDot" Width="8" Height="8" Fill="{StaticResource NeutralStatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HomeDriverText" Text="Не загружен" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус маршрутизации" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeRoutingStatusText" Grid.Row="4" Grid.Column="1" Text="Не активна" Margin="0,6,0,0" FontWeight="SemiBold"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Все приложения →" Click="OnNavigateApps" Style="{StaticResource GhostButton}"/>
              <TextBlock Text="Приложения" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource CardBorder}" Padding="0">
              <ListView x:Name="HomeActiveAppsList" BorderThickness="0" Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                  </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="90"/>
                          <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Style="{StaticResource RowPrimaryText}"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="—">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVpnSelected}" Value="True">
                                  <Setter Property="Text" Value="VPN"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDirectSelected}" Value="True">
                                  <Setter Property="Text" Value="Напрямую"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="3" Style="{StaticResource RouteRuntimeStatusBadge}" HorizontalAlignment="Right"
                                ToolTip="{Binding StatusText}">
                          <TextBlock Text="{Binding StatusText}" Style="{StaticResource RouteRuntimeStatusText}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="2">
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Все соединения →" Click="OnNavigateConnections" Style="{StaticResource GhostButton}"/>
              <TextBlock Text="Недавние соединения" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Style="{StaticResource CardBorder}" Padding="0">
              <DataGrid x:Name="HomeRecentFlowsGrid" MinHeight="120" RowHeight="32" FontSize="12"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Приложение" Binding="{Binding Application}" Width="140"/>
                  <DataGridTextColumn Header="Назначение" Binding="{Binding Destination}" Width="*"/>
                  <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="90"/>
                  <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="120"/>
                  <DataGridTextColumn Header="Обновлено" Binding="{Binding Time}" Width="90"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- APPLICATIONS -->
      <TabItem Header="Приложения">
        <TabControl x:Name="AppsInnerTabControl" Margin="4" SelectionChanged="OnAppsInnerTabChanged">
          <TabItem Header="Маршрутизация">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Добавить .exe вручную" Click="OnAddApp"
                            Style="{StaticResource PrimaryButton}" MinWidth="200"/>
                    <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" MinWidth="180"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AppSearchBox" Grid.Column="0" Margin="0,0,12,0"
                             ToolTip="Поиск по имени" TextChanged="OnAppFilterChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <ToggleButton x:Name="AppFilterAll" Content="Все" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"
                                    IsChecked="True" Click="OnAppFilterChanged"/>
                      <ToggleButton x:Name="AppFilterVpn" Content="VPN" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"
                                    Click="OnAppFilterChanged"/>
                      <ToggleButton x:Name="AppFilterDirect" Content="Напрямую" Style="{StaticResource RouteToggleButton}"
                                    Click="OnAppFilterChanged"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <Border x:Name="AppsEmptyPanel" DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                  <TextBlock Text="Пока нет приложений с отдельным маршрутом." FontSize="16" FontWeight="SemiBold"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock Text="Добавьте программу из каталога «Установленные» или вручную."
                             Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                  <Button Content="Добавить .exe вручную" Click="OnAddApp" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorder}" Padding="0,4,0,8">
                <ListView x:Name="AppsList" Style="{StaticResource DarkListView}">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource ProductListRowBorder}" ToolTip="{Binding ExePath}">
                        <Grid ClipToBounds="True">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" MinWidth="132"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Image Grid.Column="0" Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowPrimaryText}"/>
                            <TextBlock Text="{Binding ConfiguredRouteText}" Style="{StaticResource SecondaryText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="2" Style="{StaticResource RouteSegmentHost}" Margin="0,0,10,0">
                            <Grid Width="164">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <RadioButton Grid.Column="0" Content="VPN" Tag="Vpn" GroupName="{Binding Id}"
                                           Style="{StaticResource RouteSegmentRadioButton}"
                                           IsChecked="{Binding IsVpnSelected, Mode=OneWay}" Checked="OnAppRouteToggle"/>
                              <RadioButton Grid.Column="1" Content="Напрямую" Tag="Direct" GroupName="{Binding Id}"
                                           Style="{StaticResource RouteSegmentRadioButton}"
                                           IsChecked="{Binding IsDirectSelected, Mode=OneWay}" Checked="OnAppRouteToggle"/>
                            </Grid>
                          </Border>
                          <Border Grid.Column="3" Style="{StaticResource RouteRuntimeStatusBadge}" Margin="0,0,8,0"
                                  ToolTip="{Binding StatusText}">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource RouteRuntimeStatusText}"/>
                          </Border>
                          <Button Grid.Column="4" Content="Удалить" Tag="{Binding Id}" Click="OnRemoveAppRule"
                                  Style="{StaticResource DangerButton}" VerticalAlignment="Center" MinWidth="88" Padding="12,6"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </DockPanel>
          </TabItem>

          <TabItem Header="Установленные">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Обновить" Click="OnRefreshInstalledApps" Style="{StaticResource CompactSecondaryButton}" MinWidth="120" Margin="12,0,0,0"/>
                    <Grid>
                      <TextBox x:Name="InstalledAppsSearchBox" ToolTip="Поиск приложений..."
                               TextChanged="OnInstalledAppsSearchChanged"/>
                      <TextBlock x:Name="InstalledAppsSearchPlaceholder" Text="Поиск приложений..." IsHitTestVisible="False"
                                 Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                  </DockPanel>
                  <CheckBox x:Name="InstalledShowSystemCheckBox" Margin="0,10,0,0"
                            Content="Показывать системные и служебные"
                            Checked="OnInstalledDiscoveryOptionsChanged" Unchecked="OnInstalledDiscoveryOptionsChanged"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="InstalledAppsLoadingText" DockPanel.Dock="Top" Text="Загрузка каталога..."
                         Style="{StaticResource SecondaryText}" Margin="8,0,0,8" Visibility="Collapsed"/>
              <Border DockPanel.Dock="Bottom" x:Name="InstalledAppsActionBar" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Добавить через VPN" Click="OnAddInstalledSelectionVpn" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Добавить напрямую" Click="OnAddInstalledSelectionDirect"/>
                  </StackPanel>
                  <TextBlock x:Name="InstalledAppsSelectionText" VerticalAlignment="Center" Text="Выбрано: 0"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Padding="0,4,0,8">
                <ListView x:Name="InstalledAppsList" Style="{StaticResource DarkListView}"
                          SelectionChanged="OnInstalledAppsSelectionChanged">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource ProductListRowBorder}" ToolTip="{Binding ExecutablePath}">
                        <Grid HorizontalAlignment="Stretch" ClipToBounds="True">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto" MinWidth="168"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <Image Grid.Column="1" Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowPrimaryText}"/>
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="3" Style="{StaticResource ExistingRouteBadge}">
                            <TextBlock Text="{Binding ExistingRouteText}" Style="{StaticResource ExistingRouteBadgeText}"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </DockPanel>
          </TabItem>

          <TabItem Header="Запущенные">
            <DockPanel>
              <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Обновить" Click="OnRefreshRunningApps" Style="{StaticResource CompactSecondaryButton}" MinWidth="120" Margin="12,0,0,0"/>
                    <Grid>
                      <TextBox x:Name="RunningAppsSearchBox" ToolTip="Поиск приложений..."
                               TextChanged="OnRunningAppsSearchChanged"/>
                      <TextBlock x:Name="RunningAppsSearchPlaceholder" Text="Поиск приложений..." IsHitTestVisible="False"
                                 Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                  </DockPanel>
                  <CheckBox x:Name="RunningShowBackgroundCheckBox" Margin="0,10,0,0"
                            Content="Показывать фоновые и служебные процессы"
                            Checked="OnRunningDiscoveryOptionsChanged" Unchecked="OnRunningDiscoveryOptionsChanged"/>
                </StackPanel>
              </Border>
              <TextBlock x:Name="RunningAppsLoadingText" DockPanel.Dock="Top" Text="Обновление списка..."
                         Style="{StaticResource SecondaryText}" Margin="8,0,0,8" Visibility="Collapsed"/>
              <Border DockPanel.Dock="Bottom" x:Name="RunningAppsActionBar" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Добавить через VPN" Click="OnAddRunningSelectionVpn" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Добавить напрямую" Click="OnAddRunningSelectionDirect"/>
                  </StackPanel>
                  <TextBlock x:Name="RunningAppsSelectionText" VerticalAlignment="Center" Text="Выбрано: 0"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource CardBorder}" Padding="0,4,0,8">
                <ListView x:Name="RunningAppsList" Style="{StaticResource DarkListView}"
                          SelectionChanged="OnRunningAppsSelectionChanged">
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource ProductListRowBorder}" ToolTip="{Binding ExecutablePath}">
                        <Grid HorizontalAlignment="Stretch" ClipToBounds="True">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto" MinWidth="168"/>
                          </Grid.ColumnDefinitions>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                          <Image Grid.Column="1" Source="{Binding Icon}" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource RowPrimaryText}"/>
                            <TextBlock Text="{Binding Publisher}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                          </StackPanel>
                          <Border Grid.Column="3" Style="{StaticResource ExistingRouteBadge}">
                            <TextBlock Text="{Binding ExistingRouteText}" Style="{StaticResource ExistingRouteBadgeText}"/>
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </Border>
            </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- BROWSER ROUTING -->
      <TabItem Header="Браузер">
        <DockPanel Margin="4">
          <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Интеграция с расширением" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Расширение" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="BrowserTabExtensionText" Grid.Row="0" Grid.Column="1" Text="—"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Browser Proxy" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                <TextBlock x:Name="BrowserTabProxyText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="SOCKS" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                <TextBlock x:Name="BrowserTabSocksText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="VPN egress" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                <TextBlock x:Name="BrowserTabVpnEgressText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Правил" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"/>
                <TextBlock x:Name="BrowserTabRuleCountText" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,6,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <Expander DockPanel.Dock="Bottom" Header="Дополнительно" Margin="0,12,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="Сброс удаляет все правила маршрутизации сайтов. Маршрут по умолчанию станет «Напрямую»."/>
              <Button Content="Сбросить все правила" Click="OnBrowserResetAllRules" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>

          <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Добавить правило" Click="OnBrowserAddRule" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Маршрутизация сайтов" Style="{StaticResource SectionTitleText}" Margin="0,0,16,0"/>
                <TextBox x:Name="BrowserRulesSearchBox" Width="220" Margin="0,0,12,0"
                         ToolTip="Поиск по названию или домену" TextChanged="OnBrowserRulesFilterChanged"/>
                <ToggleButton x:Name="BrowserFilterAll" Content="Все" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"
                              IsChecked="True" Click="OnBrowserRulesFilterChanged"/>
                <ToggleButton x:Name="BrowserFilterVpn" Content="VPN" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"
                              Click="OnBrowserRulesFilterChanged"/>
                <ToggleButton x:Name="BrowserFilterDirect" Content="Напрямую" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"
                              Click="OnBrowserRulesFilterChanged"/>
                <ToggleButton x:Name="BrowserFilterDisabled" Content="Отключённые" Style="{StaticResource RouteToggleButton}"
                              Click="OnBrowserRulesFilterChanged"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border x:Name="BrowserRulesUnavailablePanel" DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="BrowserRulesUnavailableText" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
          </Border>

          <Border x:Name="BrowserRulesEmptyPanel" DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Visibility="Collapsed" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center" MaxWidth="480" Margin="12">
              <TextBlock Text="Пока нет правил для сайтов." FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" TextAlignment="Center"/>
              <TextBlock Text="Добавьте домен, чтобы направить его через VPN или напрямую."
                         Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
              <Button Content="Добавить правило" Click="OnBrowserAddRule" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>

          <Border x:Name="BrowserRulesListBorder" Style="{StaticResource CardBorder}" Padding="0,4,0,8">
            <ListView x:Name="BrowserRulesList" Style="{StaticResource DarkListView}">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource ProductListRowBorder}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource RowPrimaryText}"/>
                        <TextBlock Text="{Binding Host}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding MatchTypeLabel}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Background="{StaticResource BadgeVpnBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding RouteLabel}" Style="{StaticResource RouteBadgeText}"/>
                      </Border>
                      <CheckBox Grid.Column="3" Content="Вкл." IsChecked="{Binding Enabled, Mode=OneWay}"
                                Tag="{Binding}" Checked="OnBrowserRuleEnabledChanged" Unchecked="OnBrowserRuleEnabledChanged"
                                VerticalAlignment="Center" Margin="8,0"/>
                      <Button Grid.Column="4" Content="Изменить" Tag="{Binding}" Click="OnBrowserEditRule"
                              Style="{StaticResource CompactSecondaryButton}" VerticalAlignment="Center" Margin="4,0"/>
                      <Button Grid.Column="5" Content="Удалить" Tag="{Binding}" Click="OnBrowserDeleteRule"
                              Style="{StaticResource DangerButton}" VerticalAlignment="Center" Margin="4,0,0,0" Padding="12,6"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- CONNECTIONS -->
      <TabItem Header="Соединения">
        <Grid Margin="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ConnectionsMainColumn" Width="*"/>
            <ColumnDefinition x:Name="ConnectionsDetailGapColumn" Width="0"/>
            <ColumnDefinition x:Name="ConnectionsDetailColumn" Width="0"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <TextBlock DockPanel.Dock="Right" x:Name="ConnectionsRoutingStatusText" Text="VPN Route отключён"
                             FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                  <StackPanel>
                    <TextBlock Text="Соединения" Style="{StaticResource SectionTitleText}"/>
                    <TextBlock x:Name="ConnectionsSummaryText" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="TCP-соединения приложений (группировка по приложению). Полезная нагрузка не записывается."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,8">
                  <TextBox x:Name="FlowSearchBox"
                           ToolTip="Поиск: приложение, путь, удалённый адрес"/>
                  <TextBlock x:Name="FlowSearchPlaceholder" Text="Поиск по приложению, пути или адресу…"
                             IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                  <ToggleButton x:Name="FlowFilterAll" Content="Все" Style="{StaticResource RouteToggleButton}" IsChecked="True" Margin="0,0,6,0"/>
                  <ToggleButton x:Name="FlowFilterVpn" Content="VPN" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"/>
                  <ToggleButton x:Name="FlowFilterDirect" Content="Напрямую" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"/>
                  <ToggleButton x:Name="FlowFilterMixed" Content="Смешано" Style="{StaticResource RouteToggleButton}" Margin="0,0,6,0"/>
                  <ToggleButton x:Name="FlowFilterErrors" Content="Ошибки" Style="{StaticResource RouteToggleButton}"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border x:Name="ConnectionsDisconnectedPanel" DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,12" Visibility="Collapsed">
              <TextBlock Text="VPN Route отключён. Подключите VPN Route на главной вкладке, чтобы видеть активную маршрутизацию."
                         TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryText}"/>
            </Border>
            <Border x:Name="ConnectionsNoTrafficPanel" DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="24" Margin="0,0,0,12" Visibility="Collapsed">
              <TextBlock Text="Нет активных соединений. Трафик появится здесь, когда настроенные приложения установят TCP-соединения."
                         TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryText}"/>
            </Border>

            <ScrollViewer x:Name="ConnectionsListScroll" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="АКТИВНЫЕ СЕЙЧАС" Style="{StaticResource CaptionLabelText}" Margin="4,0,0,6"/>
                <ListView x:Name="ConnectionGroupsList" BorderThickness="0" Background="Transparent"
                          SelectionChanged="OnConnectionGroupSelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource ConnectionListViewItemStyle}"/>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CardBorder}" Padding="0">
                        <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                                  FocusVisualStyle="{x:Null}">
                          <Expander.Header>
                            <Grid Margin="4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Projection.ApplicationName}" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                  <Border Style="{StaticResource RouteBadgePill}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Projection.RouteSummaryLabel}" Style="{StaticResource RouteBadgeText}"/>
                                  </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Projection.ProcessPath}" Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Projection.ProcessPath}"/>
                                <TextBlock Text="{Binding Projection.MixedBreakdown}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding Projection.ActiveCountLabel}" VerticalAlignment="Center" Margin="12,0"
                                         Style="{StaticResource SecondaryText}"/>
                              <TextBlock Grid.Column="2" Text="{Binding Projection.StateSummary}" VerticalAlignment="Center" FontWeight="SemiBold" MinWidth="90"/>
                            </Grid>
                          </Expander.Header>
                          <ListView ItemsSource="{Binding Projection.ActiveEndpointAggregates}" Margin="12,0,12,12"
                                    BorderThickness="0" Background="Transparent"
                                    SelectionChanged="OnConnectionEndpointSelectionChanged"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                              <Style TargetType="ListViewItem" BasedOn="{StaticResource ConnectionListViewItemStyle}">
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                              </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                              <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="44"/>
                                      <ColumnDefinition Width="96"/>
                                      <ColumnDefinition Width="108"/>
                                      <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RemoteEndpoint}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CountSuffix}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Style="{StaticResource EndpointRouteBadgePill}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                      <TextBlock Text="{Binding RouteLabel}" Style="{StaticResource RouteBadgeText}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding DisplayStateLabel, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding SampleFlow.UpdatedAtLocalText}" Style="{StaticResource SecondaryText}" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ListView.ItemTemplate>
                          </ListView>
                        </Expander>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="НЕДАВНО ЗАКРЫТЫЕ" Style="{StaticResource CaptionLabelText}" Margin="4,12,0,6"/>
                <ListView x:Name="ConnectionRecentGroupsList" BorderThickness="0" Background="Transparent"
                          SelectionChanged="OnConnectionGroupSelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,8"/>
                      <Setter Property="Background" Value="Transparent"/>
                    </Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource CardBorder}" Padding="12">
                        <StackPanel>
                          <TextBlock Text="{Binding Projection.ApplicationName}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Projection.ProcessPath}" Style="{StaticResource SecondaryText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          <ItemsControl ItemsSource="{Binding Projection.RecentFlows}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="12" Style="{StaticResource SecondaryText}">
                                  <Run Text="{Binding RemoteEndpoint, Mode=OneWay}"/>
                                  <Run Text="  "/>
                                  <Run Text="{Binding RouteLabel, Mode=OneWay}"/>
                                  <Run Text="  "/>
                                  <Run Text="{Binding DisplayStateLabel, Mode=OneWay}"/>
                                </TextBlock>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <Border x:Name="ConnectionDetailsPanel" Grid.Column="2" Style="{StaticResource CardBorder}" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Детали" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
                <TextBlock x:Name="ConnectionDetailsText" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- DIAGNOSTICS -->
      <TabItem Header="Диагностика">
        <TabControl x:Name="DiagInnerTabs" Margin="4" Style="{StaticResource DiagPrimaryTabControl}"
                    ItemContainerStyle="{StaticResource DiagPrimaryTabItem}">
          <TabItem Header="Test Center">
        <Grid Margin="0,4,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource DiagHeroCardBorder}" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Test Center" Style="{StaticResource SectionTitleText}" FontSize="18" Margin="0,0,0,6"/>
                <TextBlock x:Name="ProductVersionText" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock x:Name="BasicDiagSummaryText" TextWrapping="Wrap" Style="{StaticResource BodyText}" FontWeight="SemiBold" MaxWidth="640"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Запустить базовую диагностику" Click="OnRunBasicDiagnostics"
                      Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" MinWidth="260" MinHeight="44" Padding="22,12"/>
            </Grid>
          </Border>

          <TabControl x:Name="TestCenterCategoryTabs" Grid.Row="1"
                      Style="{StaticResource DiagSecondaryTabControl}"
                      ItemContainerStyle="{StaticResource DiagSecondaryTabItem}">
            <TabItem Header="Базовые">
          <ScrollViewer Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="OnTestCenterScrollPreviewMouseWheel">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource DiagCategoryCardBorder}">
                <StackPanel>
                  <TextBlock Text="Сеть" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Права администратора" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="admin" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Интернет-интерфейс" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="direct-if" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DNS" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="dns" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IPv4" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="ipv4" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IPv6" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="ipv6" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource DiagCategoryCardBorder}">
                <StackPanel>
                  <TextBlock Text="VPN" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="VPN-интерфейс" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="vpn-if" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="OpenVPN" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="openvpn-exe" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Профиль OVPN" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="ovpn-profile" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Подключение VPN" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="connect-vpn" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource DiagCategoryCardBorder}">
                <StackPanel>
                  <TextBlock Text="Маршрутизация" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Маршрут напрямую" Style="{StaticResource DiagTestRowLabel}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Проверить" Tag="direct-route" Click="OnDiag" Style="{StaticResource CompactActionButton}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6" MinHeight="34">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
