                  <StackPanel>
                    <TextBlock Text="Proxy loop guard" FontWeight="SemiBold"/>
                    <TextBlock Text="Защита от петли proxy" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Запустить" Tag="proxy-loop" Click="OnDiag" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="IPv6 leak" FontWeight="SemiBold"/>
                    <TextBlock Text="Блокировка утечки IPv6" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Запустить" Tag="ipv6-leak" Click="OnDiag" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="Parent / child" FontWeight="SemiBold"/>
                    <TextBlock Text="Наследование политики процессом" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Запустить" Tag="parent-child" Click="OnDiag" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="Preferred default route" FontWeight="SemiBold"/>
                    <TextBlock Text="Предпочитаемый default route" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="Запустить" Tag="preferred-default" Click="OnDiag" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="Управление драйвером" FontWeight="SemiBold"/>
                    <TextBlock Text="Install / start / stop / uninstall" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                      <Button Content="Install" Tag="driver-install" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="Start" Tag="driver-start" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="Stop" Tag="driver-stop" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="Uninstall" Tag="driver-uninstall" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="Platform checks" FontWeight="SemiBold"/>
                    <TextBlock Text="Secure Boot, test-signing, HVCI, WDK" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                      <Button Content="Secure Boot" Tag="secure-boot" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="Test-sign" Tag="testsigning" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="HVCI" Tag="hvci" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="WDK" Tag="wdk-build" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Width="300" Margin="0,0,8,8" Padding="8">
                  <StackPanel>
                    <TextBlock Text="Служебные" FontWeight="SemiBold"/>
                    <TextBlock Text="Temp rule cleanup, fail-open kill" Style="{StaticResource SecondaryText}" FontSize="11" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                      <Button Content="Remove temp" Tag="remove-temp-rule" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                      <Button Content="Kill service" Tag="kill-service" Click="OnDiag" Style="{StaticResource GhostButton}" Margin="0,0,4,4" Padding="8,4"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </TabItem>
            <TabItem Header="Инструменты">
              <StackPanel Margin="0,4,0,8">
                <WrapPanel Margin="0,0,0,8">
                  <Button Content="Тест очистки" Click="OnDiag" Tag="cleanup" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" Padding="10,4"/>
                  <Button Content="Экспорт отчёта" Click="OnDiag" Tag="export" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" Padding="10,4"/>
                </WrapPanel>
                <Expander Header="Мастер настройки" IsExpanded="False">
                  <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Первое приложение" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,0,0,4"/>
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Right" Content="Обзор EXE" Click="OnBrowseFirstApp" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,4"/>
                      <TextBox x:Name="FirstAppBox"/>
                    </DockPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </TabItem>
          </TabControl>
        </ScrollViewer>
            <Border x:Name="DiagResultPanel" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,8,0,0" MinHeight="220" MaxHeight="300">
              <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Развернуть" Click="OnExpandTestCenterResult" Style="{StaticResource GhostButton}" MinWidth="96" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" ToolTip="Копировать результат"
                            Click="OnCopyTestCenterResult" Style="{StaticResource GhostButton}" Padding="8,4" MinWidth="36" Margin="0,0,6,0"/>
                    <Button Content="Очистить" Click="OnClearTestCenterResult" Style="{StaticResource SecondaryButton}" MinWidth="88" Padding="10,4"/>
                  </StackPanel>
                  <TextBlock x:Name="DiagResultHeadline" Text="Результат последней проверки" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="DiagResultDetailBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         MinHeight="140" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" IsTabStop="True"/>
              </DockPanel>
            </Border>
        </Grid>
          </TabItem>
          <TabItem Header="OpenVPN">
            <DockPanel Margin="8" LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                        ToolTip="Копировать журнал OpenVPN" Click="OnCopyVpnLog" Style="{StaticResource GhostButton}" Padding="8,4" MinWidth="36"/>
                <TextBlock Text="Журнал OpenVPN" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                       MinHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       TextWrapping="NoWrap" AcceptsReturn="True"/>
            </DockPanel>
          </TabItem>
          <TabItem Header="Журнал">
            <DockPanel Margin="8" LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" ToolTip="Копировать журнал диагностики"
                          Click="OnCopyDiagLog" Style="{StaticResource GhostButton}" Padding="8,4" MinWidth="36" Margin="0,0,6,0"/>
                  <Button Content="Очистить" Click="OnClearDiagLog" Style="{StaticResource SecondaryButton}" MinWidth="88" Padding="10,4"/>
                </StackPanel>
                <TextBlock Text="Журнал событий диагностики" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center"/>
              </DockPanel>
              <ListBox x:Name="DiagResults" HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>
      <!-- SETTINGS -->
      <TabItem Header="Настройки">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SetupTopGrid" Grid.Row="0" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border x:Name="SetupVpnCard" Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Подключение VPN" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource SecondaryText}"
                             Text="Выбранные приложения используют личный туннель OpenVPN. Остальной трафик остаётся на обычной маршрутизации Windows."/>
                  <TextBlock Text="Исполняемый файл OpenVPN" Style="{StaticResource SecondaryText}"/>
                  <DockPanel LastChildFill="True" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Обзор" Click="OnBrowseExe" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <TextBox x:Name="ExeBox"/>
                  </DockPanel>
                  <TextBlock Text="Профиль OpenVPN (.ovpn)" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                  <DockPanel LastChildFill="True" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Обзор" Click="OnBrowseProfile" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <TextBox x:Name="ProfileBox"/>
                  </DockPanel>
                  <CheckBox x:Name="DcoBox" Margin="0,12,0,0"
                            Content="Режим совместимости (отключить DCO)"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,12,0,4" x:Name="Ipv6Help"
                             Style="{StaticResource SecondaryText}"
                             Text="IPv6: блокировать прямой IPv6 для приложений с VPN-правилом, если у туннеля нет IPv6."/>
                  <ComboBox x:Name="Ipv6Box">
                    <ComboBoxItem Content="Авто (блокировать утечку IPv6, если у туннеля нет IPv6)"/>
                    <ComboBoxItem Content="VPN, если доступен"/>
                    <ComboBoxItem Content="Блокировать для VPN-приложений" IsSelected="True"/>
                    <ComboBoxItem Content="Разрешить напрямую (небезопасно / возможна утечка)"/>
                  </ComboBox>
                  <CheckBox x:Name="QuicBox" Margin="0,12,0,0"
                            Content="Блокировать QUIC UDP/443 для VPN-приложений"/>
                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Сохранить настройки" Click="OnSaveSetup" Style="{StaticResource PrimaryButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border x:Name="WorkVpnSettingsCard" Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Рабочий VPN" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                  <CheckBox x:Name="WorkVpnEnabledBox" Content="Включить рабочий VPN" Margin="0,0,0,8"/>
                  <TextBlock Text="Профиль (.ovpn)" Style="{StaticResource SecondaryText}"/>
                  <DockPanel LastChildFill="True" Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Content="Обзор" Click="OnBrowseWorkProfile" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                    <TextBox x:Name="WorkProfileBox"/>
                  </DockPanel>
                  <TextBlock Text="Имя пользователя" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"/>
                  <TextBox x:Name="WorkUserBox" Margin="0,4,0,0"/>
                  <CheckBox x:Name="WorkRememberUserBox" Margin="0,8,0,0" Content="Запомнить имя пользователя"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource SecondaryText}"
                             Text="Пароль не сохраняется. При подключении запрашивается один раз и передаётся службе по IPC."/>
                  <TextBlock Text="Поведение" Style="{StaticResource SectionTitleText}" Margin="0,16,0,8"/>
                  <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                             Text="После сохранения настроек подключите VPN на главной вкладке. Приложения с правилами VPN начнут использовать туннель автоматически."/>
                  <TextBlock x:Name="WizardHint" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Text=""/>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Правила сети" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Text="Доменные и IP-правила для всех процессов."/>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="Добавить домен" Click="OnAddDomain" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                    <Button Content="Добавить IP/CIDR" Click="OnAddCidr" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                    <Button Content="Добавить git.exe → Напрямую" Click="OnAddGitDirect" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <DataGrid x:Name="RulesGrid" IsReadOnly="False"
                            MinHeight="100" MaxHeight="220" ScrollViewer.CanContentScroll="True" Margin="0,0,0,8">
                    <DataGrid.Columns>
                      <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                      <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="100" IsReadOnly="True"/>
                      <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="120"/>
                      <DataGridTextColumn Header="Назначение" Binding="{Binding Target}" Width="*"/>
                      <DataGridTextColumn Header="Маршрут" Binding="{Binding ModeDisplay}" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <WrapPanel>
                    <Button Content="Удалить выбранное правило" Click="OnRemoveRule" Style="{StaticResource DangerButton}" Margin="0,0,6,0"/>
                    <Button Content="Сохранить правила" Click="OnSaveRules" Style="{StaticResource SecondaryButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                  <TextBlock Text="Служебные действия" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8"/>
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,12"
                             Text="Приостановка маршрутизации и аварийное восстановление системы."/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Приостановить маршрутизацию" Click="OnPause" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Аварийное восстановление" Click="OnEmergency" Style="{StaticResource DangerButton}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>

    <Border x:Name="BootstrapOverlay" Background="#F9FAFB" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
        <TextBlock Text="VPN Route" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12"/>
        <TextBlock x:Name="BootstrapOverlayMessage" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource SecondaryText}" Margin="0,0,0,20"/>
        <Button x:Name="BootstrapActionButton" Content="Подготовить" Click="OnBootstrapAction"
                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="180" Padding="16,8"/>
        <TextBlock x:Name="BootstrapOverlayDetail" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource SecondaryText}" Margin="0,16,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
