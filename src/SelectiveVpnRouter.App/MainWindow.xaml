<Window x:Class="SelectiveVpnRouter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selective VPN Router"
        Icon="SelectiveVpnRouter.ico"
        Height="720" Width="1100"
        MinWidth="820" MinHeight="520"
        Closing="OnClosing">
  <DockPanel x:Name="RootDock">
    <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Background="#1F2937" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Selective VPN Router" Foreground="White" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="StatusLine" Foreground="#D1D5DB" TextWrapping="Wrap" Text="Служба: проверка…"/>
          <TextBlock x:Name="IfaceLine" Foreground="#9CA3AF" TextWrapping="Wrap" Text="Напрямую: —    VPN: —"/>
        </StackPanel>
        <UniformGrid Grid.Column="1" Columns="2" Rows="2" VerticalAlignment="Center" HorizontalAlignment="Right" Width="460">
          <Button x:Name="ConnectVpnButton" Content="Подключить VPN" Click="OnStart" Style="{StaticResource HeaderPrimaryButton}"/>
          <Button x:Name="DisconnectVpnButton" Content="Отключить VPN" Click="OnStop" Style="{StaticResource HeaderButton}"/>
          <Button Content="Приостановить маршрутизацию" Click="OnPause" Style="{StaticResource HeaderButton}"/>
          <Button Content="Аварийное восстановление" Click="OnEmergency" Style="{StaticResource HeaderDangerButton}"/>
        </UniformGrid>
      </Grid>
    </Border>
    <TabControl x:Name="MainTabs">
      <TabItem Header="Правила">
        <DockPanel x:Name="RulesTabRoot" Margin="8">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Правила приложений действуют для конкретного EXE, который открывает TCP-соединение. Правила доменов, IP и CIDR действуют для всех процессов, обращающихся к этим адресам."/>
          <WrapPanel DockPanel.Dock="Bottom">
            <Button Content="Добавить приложение" Click="OnAddApp"/>
            <Button Content="Добавить домен" Click="OnAddDomain"/>
            <Button Content="Добавить IP/CIDR" Click="OnAddCidr"/>
            <Button Content="Удалить выбранное" Click="OnRemoveRule"/>
            <Button Content="Сохранить правила" Click="OnSaveRules"/>
          </WrapPanel>
          <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                    MinHeight="120" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
              <DataGridTextColumn Header="Тип" Binding="{Binding TypeDisplay}" Width="110" IsReadOnly="True"/>
              <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="140"/>
              <DataGridTextColumn Header="Назначение" Binding="{Binding Target}" Width="*"/>
              <DataGridTextColumn Header="Маршрут" Binding="{Binding ModeDisplay}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Соединения">
        <DockPanel x:Name="ConnectionsTabRoot" Margin="8">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Только метаданные. Полезная нагрузка не записывается. Процесс — это EXE, создавший TCP-поток (git.exe, запущенный из Cursor, остаётся git.exe)."/>
          <DataGrid x:Name="FlowsGrid" AutoGenerateColumns="True" IsReadOnly="True" MinHeight="120"/>
        </DockPanel>
      </TabItem>
      <TabItem Header="Тестирование">
        <DockPanel x:Name="TestTabRoot" Margin="8">
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Запускайте проверки без участия разработчика. Результаты: PASS / FAIL / WARNING. Реальные проверки Cursor/git и двух VPN — в docs/MANUAL_TEST_PLAN.md."/>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" MinHeight="120"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="260" MinHeight="80"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <WrapPanel Margin="0,8">
                <Button Content="Проверить права администратора" Click="OnDiag" Tag="admin"/>
                <Button Content="Определить интерфейсы интернета" Click="OnDiag" Tag="direct-if"/>
                <Button Content="Определить VPN-интерфейсы" Click="OnDiag" Tag="vpn-if"/>
                <Button Content="Проверить OpenVPN" Click="OnDiag" Tag="openvpn-exe"/>
                <Button Content="Проверить профиль OVPN" Click="OnDiag" Tag="ovpn-profile"/>
                <Button Content="Подключить VPN" Click="OnDiag" Tag="connect-vpn"/>
                <Button Content="Тест маршрута напрямую" Click="OnDiag" Tag="direct-route"/>
                <Button Content="Тест сокета через VPN" Click="OnDiag" Tag="vpn-bound-socket"/>
                <Button Content="Тест маршрутизации приложений" Click="OnDiag" Tag="app-routing"/>
                <Button Content="Тест DNS" Click="OnDiag" Tag="dns"/>
                <Button Content="Тест IPv4" Click="OnDiag" Tag="ipv4"/>
                <Button Content="Тест IPv6" Click="OnDiag" Tag="ipv6"/>
                <Button Content="Тест очистки" Click="OnDiag" Tag="cleanup"/>
                <Button Content="Экспорт отчёта диагностики" Click="OnDiag" Tag="export"/>
              </WrapPanel>
              <Border Margin="0,12,0,8" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Background="#F8FAFC">
                <StackPanel>
                  <TextBlock FontWeight="Bold" FontSize="14" Text="Проверка реального приложения"/>
                  <TextBlock TextWrapping="Wrap" Margin="0,6,0,8"
                             Text="Временное VPN-правило только для выбранного EXE. Постоянные Rules не меняются. Откройте приложение и выполните TCP-запрос (например, https://api.ipify.org в браузере). Внешний IP приложение проверяете вы сами — автоматически мы его не утверждаем."/>
                  <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Обзор EXE" Click="OnBrowseRealApp" MinWidth="110" Margin="8,0,0,0"/>
                    <TextBox x:Name="RealAppExeBox" IsReadOnly="True" ToolTip="Полный путь к EXE"/>
                  </DockPanel>
                  <WrapPanel Margin="0,0,0,8">
                    <Button Content="Временно направить приложение через VPN" Click="OnApplyTempRealApp"/>
                    <Button Content="Удалить временное правило приложения" Click="OnRemoveTempRealApp"/>
                    <Button Content="Обновить статус" Click="OnRefreshTempRealApp"/>
                  </WrapPanel>
                  <TextBlock x:Name="RealAppStatusLine" TextWrapping="Wrap" FontWeight="SemiBold" Text="Статус: правило не активно"/>
                  <TextBlock x:Name="RealAppDetailLine" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#4B5563" Text=""/>
                  <TextBlock x:Name="RealAppTargetStatusLine" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="Цель: —"/>
                  <TextBlock Text="External IP verification: manual" Margin="0,2,0,0" Foreground="#6B7280" FontStyle="Italic"/>
                  <TextBlock x:Name="RealAppQueriedAtLine" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="#6B7280" Text=""/>
                  <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Определить адреса" Click="OnResolveRealAppTarget" MinWidth="140" Margin="8,0,0,0"/>
                    <TextBox x:Name="RealAppTargetBox" Text="api.ipify.org:443" ToolTip="host:port для диагностики целевого TCP flow"/>
                  </DockPanel>
                  <TextBlock x:Name="RealAppResolvedTargetsLine" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="#4B5563" Text="Resolved: —"/>
                  <CheckBox x:Name="RealAppTargetFilterOnly" Content="Только целевой адрес" Margin="0,0,0,6" Checked="OnRealAppTargetFilterChanged" Unchecked="OnRealAppTargetFilterChanged"/>
                  <TextBlock FontWeight="SemiBold" Text="Последние соединения выбранного приложения"/>
                  <DataGrid x:Name="RealAppFlowGrid"
                            Margin="0,4,0,0"
                            Height="260"
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            HeadersVisibility="Column"
                            GridLinesVisibility="Horizontal"
                            SelectionMode="Single"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                      <Style TargetType="DataGridRow">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTarget}" Value="True">
                            <Setter Property="Background" Value="#E0F2FE"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Time" Binding="{Binding UpdatedAt}" Width="70"/>
                      <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55"/>
                      <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="150"/>
                      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                      <DataGridTextColumn Header="WFP" Binding="{Binding Wfp}" Width="40"/>
                      <DataGridTextColumn Header="Proxy" Binding="{Binding Proxy}" Width="50"/>
                      <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="60"/>
                      <DataGridTextColumn Header="Bound" Binding="{Binding Bound}" Width="55"/>
                      <DataGridTextColumn Header="Connected" Binding="{Binding Connected}" Width="75"/>
                      <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="60"/>
                      <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Expander Header="Advanced diagnostics" Margin="0,8,0,0">
                    <TextBlock x:Name="RealAppAdvancedLine" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text=""/>
                  </Expander>
                </StackPanel>
              </Border>
              <TextBlock Margin="0,12,0,4" FontWeight="Bold" Text="WFP-ДРАЙВЕР"/>
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                         Text="Прозрачный per-process TCP требует SelectiveVpnCallout.sys. Эти проверки не включают TESTSIGNING и не отключают Secure Boot / HVCI / BitLocker. Установка, запуск, остановка, удаление драйвера и «Убить службу» требуют подтверждения. Маршрутизация приложений не считается PASS, пока «Тест прозрачной маршрутизации» не даст PASS."/>
              <WrapPanel Margin="0,0,0,8">
                <Button Content="Проверить сборку WDK" Click="OnDiag" Tag="wdk-build"/>
                <Button Content="Проверить бинарник драйвера" Click="OnDiag" Tag="driver-binary"/>
                <Button Content="Проверить подпись драйвера" Click="OnDiag" Tag="driver-signature"/>
                <Button Content="Проверить Secure Boot" Click="OnDiag" Tag="secure-boot"/>
                <Button Content="Проверить test-signing" Click="OnDiag" Tag="testsigning"/>
                <Button Content="Проверить HVCI" Click="OnDiag" Tag="hvci"/>
                <Button Content="Установить драйвер" Click="OnDiag" Tag="driver-install"/>
                <Button Content="Запустить драйвер" Click="OnDiag" Tag="driver-start"/>
                <Button Content="Проверить регистрацию callout" Click="OnDiag" Tag="callout-registration"/>
                <Button Content="Проверить WFP-фильтры приложений" Click="OnDiag" Tag="wfp-app-filters"/>
                <Button Content="Временное правило Probe" Click="OnDiag" Tag="temp-probe-rule"/>
                <Button Content="Тест прозрачной маршрутизации" Click="OnDiag" Tag="transparent-routing"/>
                <Button Content="Удалить временное правило" Click="OnDiag" Tag="remove-temp-rule"/>
                <Button Content="Остановить драйвер" Click="OnDiag" Tag="driver-stop"/>
                <Button Content="Удалить драйвер" Click="OnDiag" Tag="driver-uninstall"/>
                <Button Content="Preferred default route" Click="OnDiag" Tag="preferred-default"/>
                <Button Content="Защита от петли proxy" Click="OnDiag" Tag="proxy-loop"/>
                <Button Content="Родитель / дочерний процесс" Click="OnDiag" Tag="parent-child"/>
                <Button Content="Защита от утечки IPv6" Click="OnDiag" Tag="ipv6-leak"/>
                <Button Content="Убить службу (fail-open)" Click="OnDiag" Tag="kill-service"/>
              </WrapPanel>
            </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#CBD5E1" ShowsPreview="True"/>
            <DockPanel Grid.Row="2" MinHeight="80">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" ToolTip="Копировать лог в буфер обмена"
                          Click="OnCopyDiagLog" Padding="8,4" MinWidth="36"/>
                  <Button Content="Очистить лог" Click="OnClearDiagLog" MinWidth="110" Padding="10,4"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="Результаты диагностики"/>
              </DockPanel>
              <ListBox x:Name="DiagResults"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Настройка">
        <ScrollViewer x:Name="SetupTabRoot" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold" Text="Первый запуск"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8" Text="Выбранные приложения используют личный туннель OpenVPN. Всё остальное остаётся на обычной маршрутизации Windows. Личный VPN запускается с --route-nopull, чтобы не перехватывать системный маршрут по умолчанию."/>
            <TextBlock Text="1. Исполняемый файл OpenVPN"/>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Обзор" Click="OnBrowseExe"/>
              <TextBox x:Name="ExeBox"/>
            </DockPanel>
            <TextBlock Text="2. Профиль OpenVPN (.ovpn)"/>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Обзор" Click="OnBrowseProfile"/>
              <TextBox x:Name="ProfileBox"/>
            </DockPanel>
            <CheckBox x:Name="DcoBox" Margin="4,8" Content="Режим совместимости (отключить DCO) — полезно, если DCO конфликтует с другим VPN или сетевым драйвером. По умолчанию выключено."/>
            <TextBlock TextWrapping="Wrap" Margin="4,8" x:Name="Ipv6Help"
                       Text="IPv6 по умолчанию: блокировать прямой IPv6 для приложений с VPN-правилом, если у туннеля нет IPv6, чтобы они не обходили VPN."/>
            <ComboBox x:Name="Ipv6Box" Margin="4">
              <ComboBoxItem Content="Авто (блокировать утечку IPv6, если у туннеля нет IPv6)"/>
              <ComboBoxItem Content="VPN, если доступен"/>
              <ComboBoxItem Content="Блокировать для VPN-приложений" IsSelected="True"/>
              <ComboBoxItem Content="Разрешить напрямую (небезопасно / возможна утечка)"/>
            </ComboBox>
            <CheckBox x:Name="QuicBox" Margin="4,8" Content="Блокировать QUIC UDP/443 для VPN-приложений (опционально, по умолчанию выкл.; принудительный fallback на TCP). Не блокирует весь UDP."/>
            <TextBlock Text="3. Первое приложение (например, Cursor.exe)"/>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Обзор EXE" Click="OnBrowseFirstApp"/>
              <TextBox x:Name="FirstAppBox"/>
            </DockPanel>
            <WrapPanel Margin="0,12">
              <Button Content="Сохранить настройки" Click="OnSaveSetup"/>
              <Button Content="Подключить и определить туннель" Click="OnStart"/>
              <Button Content="Добавить git.exe → Напрямую" Click="OnAddGitDirect"/>
            </WrapPanel>
            <TextBlock x:Name="WizardHint" TextWrapping="Wrap" Margin="0,8"
                       Text="После подключения: добавьте SelectiveVpnRouter.Probe.exe как VPN-правило приложения, запустите Probe --http и убедитесь, что в «Соединения» виден VPN. Второй Probe без правила должен остаться «Напрямую»."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Журнал VPN">
        <DockPanel x:Name="LogTabRoot" Margin="8">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                    ToolTip="Копировать журнал в буфер обмена" Click="OnCopyVpnLog" Padding="8,4" MinWidth="36"/>
            <TextBlock VerticalAlignment="Center" Foreground="#6B7280" Text="Журнал OpenVPN"/>
          </DockPanel>
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                   TextWrapping="Wrap" AcceptsReturn="True"/>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
