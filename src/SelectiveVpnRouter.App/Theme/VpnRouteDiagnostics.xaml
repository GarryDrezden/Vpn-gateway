<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="DiagHeroCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Background" Value="{StaticResource CardBackgroundElevatedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="DiagCategoryCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
    <Setter Property="Padding" Value="16"/>
    <Setter Property="MinHeight" Value="268"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="DiagToolCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
    <Setter Property="Padding" Value="14"/>
    <Setter Property="MinHeight" Value="132"/>
    <Setter Property="Margin" Value="0,0,10,10"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <Style x:Key="DiagTestRowLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>

  <Style x:Key="DiagResultLogBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="10"/>
  </Style>

  <Style x:Key="DiagPrimaryTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Padding="18,12" Margin="0,0,6,0" Background="Transparent"
                  BorderThickness="0,0,0,3" BorderBrush="Transparent" Cursor="Hand" CornerRadius="8,8,0,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DiagPrimaryTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource ShellTabBarBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="4,6,4,0" Margin="0,0,0,10">
              <TabPanel IsItemsHost="True" Background="Transparent"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent" Margin="0,4,0,0"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DiagSecondaryTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Bd" Padding="14,7" Background="Transparent" BorderThickness="0"
                  CornerRadius="6" Cursor="Hand">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryBrush}"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandPrimaryHoverBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DiagSecondaryTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundElevatedBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4" Margin="0,0,0,14">
              <TabPanel IsItemsHost="True"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
