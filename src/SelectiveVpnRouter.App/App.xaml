<Application x:Class="SelectiveVpnRouter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme/VpnRouteColors.xaml"/>
        <ResourceDictionary Source="Theme/VpnRouteTypography.xaml"/>
        <ResourceDictionary Source="Theme/VpnRouteControls.xaml"/>
        <ResourceDictionary Source="Theme/VpnRouteLists.xaml"/>
        <ResourceDictionary Source="Theme/VpnRouteDiagnostics.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
